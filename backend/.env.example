# Application Environment Configuration
APP_NAME="SIM SMS Gateway"
ENVIRONMENT="development"
DEBUG=true

# Database (SQLite default for simple local dev; PostgreSQL supported in production)
DATABASE_URL="sqlite:///./sms_gateway.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/sms_gateway"

# Security & CORS
SECRET_KEY="change-me-to-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS=["*"]

# Messaging & Gateway Defaults
DEFAULT_COUNTRY_CODE="+255"
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_LENGTH=1600
RECIPIENT_ALLOWLIST=[]

# Webhook Engine
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_ALLOW_LOCAL_URLS=false

# Job Leasing
JOB_LEASE_TIMEOUT_SECONDS=120
DEVICE_OFFLINE_THRESHOLD_SECONDS=180

# Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="hemy@2004"

# ---------------------------------------------------------------------------
# Google AI Studio / Gemini Real-time Auto-Reply Configuration
# ---------------------------------------------------------------------------
# Paste your Google AI Studio API key here (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Enable or disable automated AI SMS auto-replies
AI_AUTO_REPLY_ENABLED=true

# Model name: gemini-1.5-flash (fast & cost-effective), gemini-2.0-flash, or gemini-2.5-flash
GEMINI_MODEL="gemini-1.5-flash"

# Max tokens generated for reply (keep small for SMS, ~150 tokens = 1-2 SMS parts)
AI_MAX_OUTPUT_TOKENS=150

# Temperature (0.0 to 1.0)
AI_TEMPERATURE=0.7

# Optional custom brand/sender name prefixed on AI SMS reply (e.g. EDUSPHERE or leave empty)
AI_REPLY_SENDER_NAME=""

# System instructions given to Gemini for generating SMS responses
AI_SYSTEM_PROMPT="Wewe ni msaidizi mahiri wa SMS wa biashara yetu. Jibu kwa lugha ileile ya mteja (Kiswahili au Kiingereza). Toa majibu mafupi, yenye heshima, na kueleweka moja kwa moja (yasizidi herufi 160 inapowezekana, ukomo herufi 300). USITUMIE alama za markdown (kama nyota *, herufi nene, vichwa vya habari #, au bullet points) kwa sababu ujumbe huu unatumwa kama SMS ya kawaida kwenye simu ya mkononi."
